# ── Application ────────────────────────────────────────────
# Generate a random key: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_KEY

# ── Initial administrator account ──────────────────────────
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_12_CHARACTERS_LONG

# ── Network ────────────────────────────────────────────────
# 127.0.0.1: accessible only on the server
# 0.0.0.0: accessible on the local network
BIND_ADDRESS=127.0.0.1
PORT=8000

# Check in-transit orders every 15 minutes for confirmed delivery
TRACKING_POLL_SECONDS=900

# Set to true when the application is served over HTTPS
COOKIE_SECURE=false

# ── Telegram notifications (optional) ──────────────────────
# Set both values to receive registration and order status notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
