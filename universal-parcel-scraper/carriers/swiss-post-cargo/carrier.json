{
  "id": "swiss-post-cargo",
  "displayName": "Swiss Post Cargo",
  "aliases": [
    "Hugger"
  ],
  "region": {
    "countries": [
      "CH"
    ]
  },
  "brand": {
    "color": "#ffcc00"
  },
  "selectable": true,
  "timezone": "Europe/Zurich",
  "tracking": {
    "mode": "automatic",
    "adapter": "swiss-post-cargo",
    "steps": [
      "direct"
    ],
    "recognition": {
      "rank": 550
    }
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivered_at"
  ],
  "portal": {
    "url": "https://apv.swisspost-cargo.com/public/trackandtrace/{trackingNumber}",
    "searchUrl": "https://apv.swisspost-cargo.com/public/trackandtrace/",
    "helpUrl": "https://www.swisspost-cargo.com/ch-de/hilfe-und-kontakt",
    "canaryUrl": "https://apv.swisspost-cargo.com/public/trackandtrace",
    "shows": [
      "status",
      "history",
      "location",
      "delivered_at",
      "recipient_name",
      "recipient_address"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "provider_code",
      "delivered_at"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "apv.swisspost-cargo.com",
        "tt.swisspost-cargo.com"
      ],
      "path": "^/public/trackandtrace/([^/?#]+)/?$"
    }
  ],
  "detection": [
    {
      "id": "swiss-post-cargo-sscc",
      "pattern": "^00\\d{18}$",
      "confidence": "low",
      "checksum": "sscc"
    },
    {
      "id": "swiss-post-cargo-pl-reference",
      "pattern": "^PL\\d{8}$",
      "confidence": "low"
    }
  ]
}
