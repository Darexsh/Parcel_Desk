      ],
      "path": "^/(?:en/)?tracking/(\\d{14})(?:/|$)"
    },
    {
      "domains": [
        "novapost.com"
      ],
      "path": "^/[a-z]{2}-[a-z]{2}/tracking/((?:RS)?(?:SH|TN)[A-Z]{2}\\d{10}|1\\d{13}|(?:20[4678]|590|595)\\d{11}|(?:21|51)\\d{12})(?:/|$)"
    }
  ],
  "detection": [
    {
      "id": "nova-poshta-export",
      "pattern": "^595000\\d{8}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "nova-poshta-domestic",
      "pattern": "^(?:(?:20[4678]|590|595)\\d{11}|(?:21|51)\\d{12})$",
      "confidence": "low"
    },
    {
      "id": "nova-poshta-international",
      "pattern": "^(?:RS)?(?:SH(?!O[CPR])|TN)[A-Z]{2}\\d{10}$",
      "confidence": "low"
    }
  ]
