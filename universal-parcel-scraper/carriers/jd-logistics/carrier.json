{
  "id": "jd-logistics",
  "displayName": "JD Logistics",
  "aliases": [
    "Jingdong Logistics",
    "京东物流"
  ],
  "region": {
    "countries": [
      "CN"
    ]
  },
  "brand": {
    "color": "#e1251b"
  },
  "selectable": true,
  "timezone": "UTC",
  "tracking": {
    "mode": "automatic",
    "adapter": "jd-logistics",
    "steps": [
      "direct",
      "trawl"
    ],
    "localClocks": true,
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "provider_code",
    "delivery_tracking_number"
  ],
  "portal": {
    "url": "https://www.jingdonglogistics.com/Tracking?waybillCodes={trackingNumber}",
    "searchUrl": "https://www.jingdonglogistics.com/Tracking",
    "helpUrl": "https://www.jingdonglogistics.com/contact",
    "canaryUrl": "https://www.jingdonglogistics.com/Tracking",
    "shows": [
      "status",
      "history",
      "location",
      "delivery_tracking_number"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "delivery_tracking_number"
    ],
    "discarded": [
      "recipient_details",
      "proof_of_delivery_images"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "jingdonglogistics.com"
      ],
      "params": [
        "waybillCodes"
      ]
    }
  ],
  "detection": [
    {
      "id": "jd-logistics-1",
      "pattern": "^VG\\d{11}$",
      "confidence": "low"
    },
    {
      "id": "jd-logistics-2",
      "pattern": "^JD(?:\\d{13}|[A-Z]\\d{12}|[A-Z]{2}\\d{11})$",
      "confidence": "high"
    }
  ]
}
