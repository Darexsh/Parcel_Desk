{
  "id": "dpd",
  "displayName": "DPD Switzerland",
  "aliases": [
    "DPD (Schweiz) AG",
    "myDPD"
  ],
  "region": {
    "countries": [
      "CH"
    ]
  },
  "brand": {
    "color": "#dc0032"
  },
  "selectable": true,
  "timezone": "Europe/Zurich",
  "tracking": {
    "mode": "automatic",
    "adapter": "dpd",
    "requirements": [
      {
        "field": "postcode",
        "validator": "internationalPostcode",
        "optional": true,
        "showsMore": true,
        "label": "Delivery postcode",
        "type": "text",
        "help": "Optional. DPD uses it to unlock verified scans and the delivery window.",
        "pattern": "^(?=.{3,12}$)(?=.*[0-9])[A-Za-z0-9]+(?:[ \\-][A-Za-z0-9]+)*$",
        "maxLength": 12,
        "inputMode": "text",
        "autoComplete": "postal-code"
      }
    ],
    "steps": [
      "direct",
      "page"
    ],
    "recognition": {
      "rank": 980
    },
    "browser": true
  },
  "capabilities": [
    "history",
    "location",
    "eta",
    "sender_name",
    "pickup_point",
    "weight",
    "delivered_at",
    "provider_code"
  ],
  "portal": {
    "url": "https://www.dpdgroup.com/ch/mydpd/my-parcels/incoming?parcelNumber={trackingNumber}",
    "searchUrl": "https://www.dpd.com/ch/de/",
    "helpUrl": "https://www.dpd.com/ch/de/supportcenter/anliegen-schildern/",
    "canaryUrl": "https://www.dpdgroup.com/ch/mydpd/my-parcels/incoming",
    "shows": [
      "status",
      "history",
      "location",
      "eta",
      "eta_window",
      "sender_name",
      "pickup_point",
      "weight"
    ],
    "scraped": [
      "status",
      "history",
      "location",
      "eta",
      "eta_window",
      "sender_name",
      "pickup_point",
      "weight",
      "delivered_at",
      "provider_code"
    ],
    "discarded": [
      "recipient_name",
      "recipient_address"
    ],
    "unavailable": []
  },
  "links": [
    {
      "domains": [
        "dpdgroup.com",
        "dpd.com"
      ],
      "pathPattern": "^/ch(?:/|$)",
      "params": [
        "parcelNumber",
        "parcelnumber"
      ]
    }
  ],
  "detection": [
    {
      "id": "dpd-2",
      "pattern": "^06[01]\\d{11}$",
      "confidence": "low",
      "preferred": true
    },
    {
      "id": "dpd-1",
      "pattern": "^\\d{14}$",
      "confidence": "low"
    },
    {
      "id": "dpd-3",
      "pattern": "^\\d{14}[0-9A-Z]$",
      "confidence": "low",
      "checksum": "dpd"
    }
  ]
}
